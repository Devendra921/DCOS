      <bpmndi:BPMNEdge id="Flow_start_design_di" bpmnElement="Flow_start_design">
        <di:waypoint x="308" y="155" />
        <di:waypoint x="375" y="155" />
        <di:waypoint x="375" y="305" />
        <di:waypoint x="400" y="305" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_design_g_design_di" bpmnElement="Flow_design_g_design">
        <di:waypoint x="520" y="305" />
        <di:waypoint x="605" y="305" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_g_design_raise_tiein_di" bpmnElement="Flow_g_design_raise_tiein">
        <di:waypoint x="655" y="305" />
        <di:waypoint x="715" y="305" />
        <di:waypoint x="715" y="560" />
        <di:waypoint x="740" y="560" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_g_design_revise_design_di" bpmnElement="Flow_g_design_revise_design">
        <di:waypoint x="655" y="305" />
        <di:waypoint x="715" y="305" />
