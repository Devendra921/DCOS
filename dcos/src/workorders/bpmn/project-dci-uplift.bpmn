        <di:waypoint x="988" y="710" />
        <di:waypoint x="1055" y="710" />
        <di:waypoint x="1055" y="455" />
        <di:waypoint x="1080" y="455" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_handover_raise_turnup_di" bpmnElement="Flow_handover_raise_turnup">
        <di:waypoint x="1200" y="455" />
        <di:waypoint x="1225" y="455" />
        <di:waypoint x="1225" y="710" />
        <di:waypoint x="1250" y="710" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_raise_turnup_wait_turnup_di" bpmnElement="Flow_raise_turnup_wait_turnup">
        <di:waypoint x="1370" y="710" />
        <di:waypoint x="1462" y="710" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_wait_turnup_acceptance_di" bpmnElement="Flow_wait_turnup_acceptance">
        <di:waypoint x="1498" y="710" />
