        <di:waypoint x="1565" y="305" />
        <di:waypoint x="1590" y="305" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_acceptance_g_tests_di" bpmnElement="Flow_acceptance_g_tests">
        <di:waypoint x="1710" y="305" />
        <di:waypoint x="1795" y="305" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_chase_carrier_handover_di" bpmnElement="Flow_chase_carrier_handover">
        <di:waypoint x="1310" y="600" />
        <di:waypoint x="1310" y="512" />
        <di:waypoint x="1140" y="512" />
        <di:waypoint x="1140" y="495" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_g_tests_raise_cutover_di" bpmnElement="Flow_g_tests_raise_cutover">
        <di:waypoint x="1845" y="305" />
        <di:waypoint x="1905" y="305" />
        <di:waypoint x="1905" y="710" />
        <di:waypoint x="1930" y="710" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_g_tests_fix_path_di" bpmnElement="Flow_g_tests_fix_path">
        <di:waypoint x="1845" y="305" />
        <di:waypoint x="1905" y="305" />
        <di:waypoint x="1905" y="815" />
