<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_project_dci_uplift" targetNamespace="http://dcos.example.com/workorders" exporter="DCOS process generator" exporterVersion="1.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.6.0">
  <bpmn:collaboration id="Collaboration_project_dci_uplift">
    <bpmn:participant id="Participant_project_dci_uplift" name="PRJ-13 · DCI and WAN uplift" processRef="project-dci-uplift" />
  </bpmn:collaboration>
  <bpmn:process id="project-dci-uplift" name="DCI and WAN uplift" isExecutable="true">
    <bpmn:documentation>Adds capacity between two sites: the path and diversity design is approved, carrier orders are placed, cross-connects (LOA/CFA) run as work orders, carriers hand the circuits over (a slipped date is chased), optics and line cards are installed and turned up, acceptance tests per path must pass, traffic is cut over in a change window and the old circuits are ceased and their optics recovered.</bpmn:documentation>
    <bpmn:extensionElements>
      <zeebe:versionTag value="v1" />
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_project_dci_uplift">
      <bpmn:lane id="Lane_Project_manager" name="Project manager">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Network_design" name="Network design">
        <bpmn:flowNodeRef>design</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>acceptance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_tests</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Procurement" name="Procurement">
        <bpmn:flowNodeRef>orders</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_carrier_late</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>chase_carrier</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Installation" name="Installation">
        <bpmn:flowNodeRef>raise_xconnect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait_xconnect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>raise_turnup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait_turnup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix_path</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>raise_cutover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait_cutover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>raise_cease</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait_cease</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Operations" name="Operations">
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Uplift approved">
      <bpmn:outgoing>Flow_start_design</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="design" name="Approve path and diversity design">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formKey="design-review" />
        <zeebe:assignmentDefinition candidateGroups="Network Engineer" />
        <zeebe:taskSchedule dueDate="=now() + duration(&#34;P2D&#34;)" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start_design</bpmn:incoming>
      <bpmn:outgoing>Flow_design_orders</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="orders" name="Place carrier orders">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formKey="complete-with-evidence" />
        <zeebe:assignmentDefinition candidateGroups="Finance Manager" />
        <zeebe:taskSchedule dueDate="=now() + duration(&#34;P1D&#34;)" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_design_orders</bpmn:incoming>
      <bpmn:outgoing>Flow_orders_raise_xconnect</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="raise_xconnect" name="Raise cross-connect work orders">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="dcos.raise-work-orders" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_orders_raise_xconnect</bpmn:incoming>
      <bpmn:outgoing>Flow_raise_xconnect_wait_xconnect</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="wait_xconnect" name="Cross-connect work closed">
      <bpmn:incoming>Flow_raise_xconnect_wait_xconnect</bpmn:incoming>
      <bpmn:outgoing>Flow_wait_xconnect_handover</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_wait_xconnect" messageRef="Message_wait_xconnect" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="handover" name="Receive circuit handover">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formKey="complete-with-evidence" />
        <zeebe:assignmentDefinition candidateGroups="Finance Manager" />
        <zeebe:taskSchedule dueDate="=now() + duration(&#34;P20D&#34;)" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_wait_xconnect_handover</bpmn:incoming>
      <bpmn:incoming>Flow_chase_carrier_handover</bpmn:incoming>
      <bpmn:outgoing>Flow_handover_raise_turnup</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="b_carrier_late" name="Carrier date slipped" attachedToRef="handover" cancelActivity="false">
      <bpmn:outgoing>Flow_b_carrier_late_chase_carrier</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_b_carrier_late" messageRef="Message_b_carrier_late" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="chase_carrier" name="Chase the carrier">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formKey="chase-up" />
        <zeebe:assignmentDefinition candidateGroups="Finance Manager" />
        <zeebe:taskSchedule dueDate="=now() + duration(&#34;PT8H&#34;)" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_b_carrier_late_chase_carrier</bpmn:incoming>
      <bpmn:outgoing>Flow_chase_carrier_handover</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="raise_turnup" name="Raise optics and turn-up work orders">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="dcos.raise-work-orders" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_handover_raise_turnup</bpmn:incoming>
      <bpmn:outgoing>Flow_raise_turnup_wait_turnup</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="wait_turnup" name="Optics and turn-up work closed">
      <bpmn:incoming>Flow_raise_turnup_wait_turnup</bpmn:incoming>
      <bpmn:outgoing>Flow_wait_turnup_acceptance</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_wait_turnup" messageRef="Message_wait_turnup" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="acceptance" name="Acceptance tests per path">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formKey="acceptance-tests" />
        <zeebe:assignmentDefinition candidateGroups="Network Engineer" />
        <zeebe:taskSchedule dueDate="=now() + duration(&#34;P3D&#34;)" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_wait_turnup_acceptance</bpmn:incoming>
      <bpmn:incoming>Flow_fix_path_acceptance</bpmn:incoming>
      <bpmn:outgoing>Flow_acceptance_g_tests</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_tests" name="Tests passed?" default="Flow_g_tests_raise_cutover">
      <bpmn:incoming>Flow_acceptance_g_tests</bpmn:incoming>
      <bpmn:outgoing>Flow_g_tests_raise_cutover</bpmn:outgoing>
      <bpmn:outgoing>Flow_g_tests_fix_path</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="fix_path" name="Fix the failing path">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formKey="fix-findings" />
        <zeebe:assignmentDefinition candidateGroups="Field Technician" />
        <zeebe:taskSchedule dueDate="=now() + duration(&#34;P1D&#34;)" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_g_tests_fix_path</bpmn:incoming>
      <bpmn:outgoing>Flow_fix_path_acceptance</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="raise_cutover" name="Raise traffic cut-over work orders">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="dcos.raise-work-orders" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_g_tests_raise_cutover</bpmn:incoming>
      <bpmn:outgoing>Flow_raise_cutover_wait_cutover</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="wait_cutover" name="Traffic cut-over work closed">
      <bpmn:incoming>Flow_raise_cutover_wait_cutover</bpmn:incoming>
      <bpmn:outgoing>Flow_wait_cutover_raise_cease</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_wait_cutover" messageRef="Message_wait_cutover" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="raise_cease" name="Raise circuit cease and optics recovery work orders">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="dcos.raise-work-orders" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_wait_cutover_raise_cease</bpmn:incoming>
      <bpmn:outgoing>Flow_raise_cease_wait_cease</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="wait_cease" name="Circuit cease and optics recovery work closed">
      <bpmn:incoming>Flow_raise_cease_wait_cease</bpmn:incoming>
      <bpmn:outgoing>Flow_wait_cease_end</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_wait_cease" messageRef="Message_wait_cease" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="end" name="Uplift in service">
      <bpmn:incoming>Flow_wait_cease_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_start_design" sourceRef="start" targetRef="design" />
    <bpmn:sequenceFlow id="Flow_design_orders" sourceRef="design" targetRef="orders" />
    <bpmn:sequenceFlow id="Flow_orders_raise_xconnect" sourceRef="orders" targetRef="raise_xconnect" />
    <bpmn:sequenceFlow id="Flow_raise_xconnect_wait_xconnect" sourceRef="raise_xconnect" targetRef="wait_xconnect" />
    <bpmn:sequenceFlow id="Flow_wait_xconnect_handover" sourceRef="wait_xconnect" targetRef="handover" />
    <bpmn:sequenceFlow id="Flow_handover_raise_turnup" sourceRef="handover" targetRef="raise_turnup" />
    <bpmn:sequenceFlow id="Flow_raise_turnup_wait_turnup" sourceRef="raise_turnup" targetRef="wait_turnup" />
    <bpmn:sequenceFlow id="Flow_wait_turnup_acceptance" sourceRef="wait_turnup" targetRef="acceptance" />
    <bpmn:sequenceFlow id="Flow_acceptance_g_tests" sourceRef="acceptance" targetRef="g_tests" />
    <bpmn:sequenceFlow id="Flow_chase_carrier_handover" sourceRef="chase_carrier" targetRef="handover" />
    <bpmn:sequenceFlow id="Flow_g_tests_raise_cutover" name="passed" sourceRef="g_tests" targetRef="raise_cutover">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=failedTests = 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_g_tests_fix_path" name="failed" sourceRef="g_tests" targetRef="fix_path">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=failedTests &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_fix_path_acceptance" sourceRef="fix_path" targetRef="acceptance" />
    <bpmn:sequenceFlow id="Flow_raise_cutover_wait_cutover" sourceRef="raise_cutover" targetRef="wait_cutover" />
    <bpmn:sequenceFlow id="Flow_wait_cutover_raise_cease" sourceRef="wait_cutover" targetRef="raise_cease" />
    <bpmn:sequenceFlow id="Flow_raise_cease_wait_cease" sourceRef="raise_cease" targetRef="wait_cease" />
    <bpmn:sequenceFlow id="Flow_wait_cease_end" sourceRef="wait_cease" targetRef="end" />
    <bpmn:sequenceFlow id="Flow_b_carrier_late_chase_carrier" sourceRef="b_carrier_late" targetRef="chase_carrier" />
  </bpmn:process>
  <bpmn:message id="Message_wait_xconnect" name="work-orders-closed">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=businessKey + &#34;:wait_xconnect&#34;" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_b_carrier_late" name="carrier-delayed">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=businessKey" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_wait_turnup" name="work-orders-closed">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=businessKey + &#34;:wait_turnup&#34;" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_wait_cutover" name="work-orders-closed">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=businessKey + &#34;:wait_cutover&#34;" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_wait_cease" name="work-orders-closed">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=businessKey + &#34;:wait_cease&#34;" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmndi:BPMNDiagram id="BPMNDiagram_project_dci_uplift">
    <bpmndi:BPMNPlane id="BPMNPlane_project_dci_uplift" bpmnElement="Collaboration_project_dci_uplift">
      <bpmndi:BPMNShape id="Participant_project_dci_uplift_di" bpmnElement="Participant_project_dci_uplift" isHorizontal="true">
