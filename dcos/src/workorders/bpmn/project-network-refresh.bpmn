        <di:waypoint x="2245" y="710" />
        <di:waypoint x="2312" y="710" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
