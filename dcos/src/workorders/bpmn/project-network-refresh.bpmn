        <di:waypoint x="1225" y="710" />
        <di:waypoint x="1225" y="560" />
        <di:waypoint x="1250" y="560" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_raise_cutover_wait_cutover_di" bpmnElement="Flow_raise_cutover_wait_cutover">
        <di:waypoint x="1370" y="560" />
        <di:waypoint x="1462" y="560" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_wait_cutover_validate_di" bpmnElement="Flow_wait_cutover_validate">
        <di:waypoint x="1498" y="560" />
        <di:waypoint x="1565" y="560" />
        <di:waypoint x="1565" y="710" />
        <di:waypoint x="1590" y="710" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_validate_g_healthy_di" bpmnElement="Flow_validate_g_healthy">
