        <di:waypoint x="1795" y="710" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_g_healthy_raise_removal_di" bpmnElement="Flow_g_healthy_raise_removal">
        <di:waypoint x="1845" y="710" />
        <di:waypoint x="1905" y="710" />
        <di:waypoint x="1905" y="560" />
        <di:waypoint x="1930" y="560" />
      </bpmndi:BPMNEdge>
