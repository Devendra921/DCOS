        <di:waypoint x="545" y="155" />
        <di:waypoint x="570" y="155" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_consent_g_consent_di" bpmnElement="Flow_consent_g_consent">
        <di:waypoint x="690" y="155" />
        <di:waypoint x="775" y="155" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_escalate_consent_di" bpmnElement="Flow_escalate_consent">
        <di:waypoint x="800" y="300" />
        <di:waypoint x="800" y="212" />
        <di:waypoint x="630" y="212" />
        <di:waypoint x="630" y="195" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_g_consent_receive_di" bpmnElement="Flow_g_consent_receive">
        <di:waypoint x="825" y="155" />
        <di:waypoint x="885" y="155" />
        <di:waypoint x="885" y="560" />
        <di:waypoint x="910" y="560" />
      </bpmndi:BPMNEdge>
