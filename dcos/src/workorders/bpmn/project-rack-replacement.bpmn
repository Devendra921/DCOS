        <di:waypoint x="1055" y="560" />
        <di:waypoint x="1055" y="815" />
        <di:waypoint x="1080" y="815" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_raise_pilot_wait_pilot_di" bpmnElement="Flow_raise_pilot_wait_pilot">
        <di:waypoint x="1200" y="815" />
        <di:waypoint x="1292" y="815" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_wait_pilot_raise_swaps_di" bpmnElement="Flow_wait_pilot_raise_swaps">
        <di:waypoint x="1328" y="815" />
        <di:waypoint x="1420" y="815" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_raise_swaps_wait_swaps_di" bpmnElement="Flow_raise_swaps_wait_swaps">
        <di:waypoint x="1540" y="815" />
        <di:waypoint x="1632" y="815" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_wait_swaps_raise_removal_di" bpmnElement="Flow_wait_swaps_raise_removal">
        <di:waypoint x="1668" y="815" />
