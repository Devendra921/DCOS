        <di:waypoint x="1880" y="815" />
        <di:waypoint x="1972" y="815" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_wait_removal_records_di" bpmnElement="Flow_wait_removal_records">
        <di:waypoint x="2008" y="815" />
        <di:waypoint x="2075" y="815" />
        <di:waypoint x="2075" y="965" />
        <di:waypoint x="2100" y="965" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_records_end_di" bpmnElement="Flow_records_end">
        <di:waypoint x="2220" y="965" />
        <di:waypoint x="2312" y="965" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_b_consent_overdue_escalate_di" bpmnElement="Flow_b_consent_overdue_escalate">
        <di:waypoint x="660" y="213" />
        <di:waypoint x="660" y="223" />
        <di:waypoint x="715" y="223" />
        <di:waypoint x="715" y="260" />
        <di:waypoint x="740" y="260" />
