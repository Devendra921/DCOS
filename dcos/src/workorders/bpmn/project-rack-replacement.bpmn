        <di:waypoint x="375" y="155" />
        <di:waypoint x="375" y="410" />
        <di:waypoint x="400" y="410" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_method_consent_di" bpmnElement="Flow_method_consent">
        <di:waypoint x="520" y="410" />
