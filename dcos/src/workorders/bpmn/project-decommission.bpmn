        <di:waypoint x="1905" y="305" />
        <di:waypoint x="1930" y="305" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_records_end_di" bpmnElement="Flow_records_end">
        <di:waypoint x="2050" y="305" />
        <di:waypoint x="2142" y="305" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
