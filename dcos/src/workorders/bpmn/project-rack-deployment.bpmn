      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="order_di" bpmnElement="order">
        <dc:Bounds x="740" y="520" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="receive_di" bpmnElement="receive">
        <dc:Bounds x="910" y="520" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="b_delayed_expedite_di" bpmnElement="b_delayed_expedite">
        <dc:Bounds x="982" y="582" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="expedite_di" bpmnElement="expedite">
        <dc:Bounds x="1080" y="625" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="raise_install_di" bpmnElement="raise_install">
        <dc:Bounds x="1080" y="775" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="wait_install_di" bpmnElement="wait_install">
        <dc:Bounds x="1292" y="797" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="raise_cabling_di" bpmnElement="raise_cabling">
        <dc:Bounds x="1420" y="775" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="wait_cabling_di" bpmnElement="wait_cabling">
        <dc:Bounds x="1632" y="797" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="raise_burnin_di" bpmnElement="raise_burnin">
        <dc:Bounds x="1760" y="775" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="wait_burnin_di" bpmnElement="wait_burnin">
        <dc:Bounds x="1972" y="797" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="validate_di" bpmnElement="validate">
        <dc:Bounds x="2100" y="1030" width="120" height="80" />
      </bpmndi:BPMNShape>
