        <dc:Bounds x="2305" y="1045" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fix_di" bpmnElement="fix">
        <dc:Bounds x="2440" y="880" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="handover_di" bpmnElement="handover">
        <dc:Bounds x="2440" y="1030" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="release_di" bpmnElement="release">
        <dc:Bounds x="2610" y="1030" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="2822" y="1052" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_start_design_di" bpmnElement="Flow_start_design">
        <di:waypoint x="308" y="155" />
        <di:waypoint x="375" y="155" />
        <di:waypoint x="375" y="305" />
        <di:waypoint x="400" y="305" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_design_g_capacity_di" bpmnElement="Flow_design_g_capacity">
        <di:waypoint x="520" y="305" />
        <di:waypoint x="605" y="305" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_g_capacity_order_di" bpmnElement="Flow_g_capacity_order">
        <di:waypoint x="655" y="305" />
        <di:waypoint x="715" y="305" />
        <di:waypoint x="715" y="560" />
        <di:waypoint x="740" y="560" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_g_capacity_replan_di" bpmnElement="Flow_g_capacity_replan">
        <di:waypoint x="655" y="305" />
        <di:waypoint x="715" y="305" />
        <di:waypoint x="715" y="410" />
        <di:waypoint x="740" y="410" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_replan_design_di" bpmnElement="Flow_replan_design">
        <di:waypoint x="800" y="450" />
        <di:waypoint x="800" y="362" />
        <di:waypoint x="460" y="362" />
        <di:waypoint x="460" y="345" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_order_receive_di" bpmnElement="Flow_order_receive">
        <di:waypoint x="860" y="560" />
        <di:waypoint x="910" y="560" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_receive_raise_install_di" bpmnElement="Flow_receive_raise_install">
        <di:waypoint x="1030" y="560" />
        <di:waypoint x="1055" y="560" />
        <di:waypoint x="1055" y="815" />
        <di:waypoint x="1080" y="815" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_raise_install_wait_install_di" bpmnElement="Flow_raise_install_wait_install">
        <di:waypoint x="1200" y="815" />
