      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="raise_pilot_di" bpmnElement="raise_pilot">
        <dc:Bounds x="1080" y="625" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="wait_pilot_di" bpmnElement="wait_pilot">
