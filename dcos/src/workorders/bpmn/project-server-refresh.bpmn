        <di:waypoint x="715" y="665" />
        <di:waypoint x="740" y="665" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_raise_burnin_wait_burnin_di" bpmnElement="Flow_raise_burnin_wait_burnin">
        <di:waypoint x="860" y="665" />
        <di:waypoint x="952" y="665" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_wait_burnin_raise_pilot_di" bpmnElement="Flow_wait_burnin_raise_pilot">
        <di:waypoint x="988" y="665" />
        <di:waypoint x="1080" y="665" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_raise_pilot_wait_pilot_di" bpmnElement="Flow_raise_pilot_wait_pilot">
        <di:waypoint x="1200" y="665" />
        <di:waypoint x="1292" y="665" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_wait_pilot_pilot_review_di" bpmnElement="Flow_wait_pilot_pilot_review">
        <di:waypoint x="1328" y="665" />
        <di:waypoint x="1395" y="665" />
        <di:waypoint x="1395" y="815" />
        <di:waypoint x="1420" y="815" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_pilot_review_g_pilot_di" bpmnElement="Flow_pilot_review_g_pilot">
        <di:waypoint x="1540" y="815" />
        <di:waypoint x="1625" y="815" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_expedite_receive_di" bpmnElement="Flow_expedite_receive">
        <di:waypoint x="800" y="555" />
        <di:waypoint x="800" y="467" />
        <di:waypoint x="630" y="467" />
        <di:waypoint x="630" y="450" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_g_pilot_raise_waves_di" bpmnElement="Flow_g_pilot_raise_waves">
        <di:waypoint x="1675" y="815" />
        <di:waypoint x="1735" y="815" />
        <di:waypoint x="1735" y="665" />
        <di:waypoint x="1760" y="665" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_g_pilot_adjust_di" bpmnElement="Flow_g_pilot_adjust">
        <di:waypoint x="1675" y="815" />
        <di:waypoint x="1735" y="815" />
        <di:waypoint x="1735" y="260" />
        <di:waypoint x="1760" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_adjust_raise_pilot_di" bpmnElement="Flow_adjust_raise_pilot">
        <di:waypoint x="1820" y="300" />
        <di:waypoint x="1820" y="722" />
        <di:waypoint x="1140" y="722" />
        <di:waypoint x="1140" y="705" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_raise_waves_wait_waves_di" bpmnElement="Flow_raise_waves_wait_waves">
        <di:waypoint x="1880" y="665" />
        <di:waypoint x="1972" y="665" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_wait_waves_raise_disposal_di" bpmnElement="Flow_wait_waves_raise_disposal">
        <di:waypoint x="2008" y="665" />
        <di:waypoint x="2100" y="665" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_raise_disposal_wait_disposal_di" bpmnElement="Flow_raise_disposal_wait_disposal">
        <di:waypoint x="2220" y="665" />
        <di:waypoint x="2312" y="665" />
