        <di:waypoint x="308" y="155" />
        <di:waypoint x="400" y="155" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_mapping_receive_di" bpmnElement="Flow_mapping_receive">
        <di:waypoint x="520" y="155" />
        <di:waypoint x="545" y="155" />
        <di:waypoint x="545" y="410" />
        <di:waypoint x="570" y="410" />
      </bpmndi:BPMNEdge>
