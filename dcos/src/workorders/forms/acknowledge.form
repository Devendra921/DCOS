{
  "$schema": "https://unpkg.com/@camunda/form-json-schema/resources/schema.json",
  "schemaVersion": 18,
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.7.0",
  "exporter": {
    "name": "DCOS process generator",
    "version": "1.1"
  },
  "id": "acknowledge",
  "type": "default",
  "components": [
    { "id": "Text_ack_intro", "type": "text", "text": "### Acknowledge\nTake ownership of this step. Acknowledging stops the escalation timer and tells the team you are on it." },
    { "id": "Field_acknowledged", "type": "checkbox", "key": "acknowledged", "label": "I take ownership of this step", "validate": {"required": true} },
    { "id": "Field_eta", "type": "select", "key": "eta", "label": "When will you give the next update?", "values": [{"label": "Within 15 minutes", "value": "PT15M"}, {"label": "Within 1 hour", "value": "PT1H"}, {"label": "Within 4 hours", "value": "PT4H"}, {"label": "Next business day", "value": "P1D"}], "defaultValue": "PT1H" },
    { "id": "Field_note", "type": "textarea", "key": "note", "label": "Note (optional)" }
  ]
}
