      <bpmndi:BPMNEdge id="Flow_start_design_di" bpmnElement="Flow_start_design">
        <di:waypoint x="308" y="155" />
        <di:waypoint x="375" y="155" />
        <di:waypoint x="375" y="410" />
        <di:waypoint x="400" y="410" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_design_g_design_di" bpmnElement="Flow_design_g_design">
        <di:waypoint x="520" y="410" />
        <di:waypoint x="605" y="410" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_g_design_award_di" bpmnElement="Flow_g_design_award">
        <di:waypoint x="655" y="410" />
        <di:waypoint x="715" y="410" />
        <di:waypoint x="715" y="665" />
        <di:waypoint x="740" y="665" />
