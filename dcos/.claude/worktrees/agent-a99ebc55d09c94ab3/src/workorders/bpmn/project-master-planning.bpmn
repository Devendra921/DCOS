<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_project_master_planning" targetNamespace="http://dcos.example.com/workorders" exporter="DCOS process generator" exporterVersion="1.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.6.0">
  <bpmn:collaboration id="Collaboration_project_master_planning">
    <bpmn:participant id="Participant_project_master_planning" name="PRJ-08 · Facility master planning" processRef="project-master-planning" />
  </bpmn:collaboration>
  <bpmn:process id="project-master-planning" name="Facility master planning" isExecutable="true">
    <bpmn:documentation>Produces a site or campus master plan: demand and growth are agreed, site and utility surveys run as work orders (intrusive surveys under change), concept options and the feasibility and cost model are prepared, and the board approves the plan (revisions go back to design) before it is published.</bpmn:documentation>
    <bpmn:extensionElements>
      <zeebe:versionTag value="v1" />
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_project_master_planning">
      <bpmn:lane id="Lane_Project_manager" name="Project manager">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>demand</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Design" name="Design">
        <bpmn:flowNodeRef>concept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>revise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>publish</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Contractor" name="Contractor">
        <bpmn:flowNodeRef>raise_survey</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait_survey</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Leadership" name="Leadership">
        <bpmn:flowNodeRef>board</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_board</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Planning commissioned">
      <bpmn:outgoing>Flow_start_demand</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="demand" name="Agree demand and growth model">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formKey="complete-with-evidence" />
        <zeebe:assignmentDefinition candidateGroups="Project Manager" />
        <zeebe:taskSchedule dueDate="=now() + duration(&#34;PT80H&#34;)" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start_demand</bpmn:incoming>
      <bpmn:outgoing>Flow_demand_raise_survey</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="raise_survey" name="Raise site and utility survey work orders">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="dcos.raise-work-orders" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_demand_raise_survey</bpmn:incoming>
      <bpmn:outgoing>Flow_raise_survey_wait_survey</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="wait_survey" name="Site and utility survey work closed">
      <bpmn:incoming>Flow_raise_survey_wait_survey</bpmn:incoming>
      <bpmn:outgoing>Flow_wait_survey_concept</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_wait_survey" messageRef="Message_wait_survey" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="concept" name="Develop concept options">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formKey="complete-with-evidence" />
        <zeebe:assignmentDefinition candidateGroups="Facilities Engineer" />
        <zeebe:taskSchedule dueDate="=now() + duration(&#34;P4D&#34;)" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_wait_survey_concept</bpmn:incoming>
      <bpmn:outgoing>Flow_concept_cost</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="cost" name="Feasibility and cost model">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formKey="complete-with-evidence" />
        <zeebe:assignmentDefinition candidateGroups="Facilities Engineer" />
        <zeebe:taskSchedule dueDate="=now() + duration(&#34;PT64H&#34;)" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_concept_cost</bpmn:incoming>
      <bpmn:outgoing>Flow_cost_board</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="board" name="Board review">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formKey="approve" />
        <zeebe:assignmentDefinition candidateGroups="Executive" />
        <zeebe:taskSchedule dueDate="=now() + duration(&#34;PT40H&#34;)" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_cost_board</bpmn:incoming>
      <bpmn:incoming>Flow_revise_board</bpmn:incoming>
      <bpmn:outgoing>Flow_board_g_board</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_board" name="Plan approved?" default="Flow_g_board_publish">
      <bpmn:incoming>Flow_board_g_board</bpmn:incoming>
      <bpmn:outgoing>Flow_g_board_publish</bpmn:outgoing>
      <bpmn:outgoing>Flow_g_board_revise</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="revise" name="Revise the plan">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formKey="complete-with-evidence" />
        <zeebe:assignmentDefinition candidateGroups="Facilities Engineer" />
        <zeebe:taskSchedule dueDate="=now() + duration(&#34;PT40H&#34;)" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_g_board_revise</bpmn:incoming>
      <bpmn:outgoing>Flow_revise_board</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="publish" name="Publish the master plan">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="dcos.publish" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_g_board_publish</bpmn:incoming>
      <bpmn:outgoing>Flow_publish_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end" name="Master plan signed">
      <bpmn:incoming>Flow_publish_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_start_demand" sourceRef="start" targetRef="demand" />
    <bpmn:sequenceFlow id="Flow_demand_raise_survey" sourceRef="demand" targetRef="raise_survey" />
    <bpmn:sequenceFlow id="Flow_raise_survey_wait_survey" sourceRef="raise_survey" targetRef="wait_survey" />
    <bpmn:sequenceFlow id="Flow_wait_survey_concept" sourceRef="wait_survey" targetRef="concept" />
    <bpmn:sequenceFlow id="Flow_concept_cost" sourceRef="concept" targetRef="cost" />
    <bpmn:sequenceFlow id="Flow_cost_board" sourceRef="cost" targetRef="board" />
    <bpmn:sequenceFlow id="Flow_board_g_board" sourceRef="board" targetRef="g_board" />
    <bpmn:sequenceFlow id="Flow_g_board_publish" name="approved" sourceRef="g_board" targetRef="publish">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_g_board_revise" name="revise" sourceRef="g_board" targetRef="revise">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_revise_board" sourceRef="revise" targetRef="board" />
    <bpmn:sequenceFlow id="Flow_publish_end" sourceRef="publish" targetRef="end" />
  </bpmn:process>
  <bpmn:message id="Message_wait_survey" name="work-orders-closed">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=businessKey + &#34;:wait_survey&#34;" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmndi:BPMNDiagram id="BPMNDiagram_project_master_planning">
    <bpmndi:BPMNPlane id="BPMNPlane_project_master_planning" bpmnElement="Collaboration_project_master_planning">
      <bpmndi:BPMNShape id="Participant_project_master_planning_di" bpmnElement="Participant_project_master_planning" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1790" height="705" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Project_manager_di" bpmnElement="Lane_Project_manager" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1760" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Design_di" bpmnElement="Lane_Design" isHorizontal="true">
        <dc:Bounds x="190" y="230" width="1760" height="255" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Contractor_di" bpmnElement="Lane_Contractor" isHorizontal="true">
        <dc:Bounds x="190" y="485" width="1760" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Leadership_di" bpmnElement="Lane_Leadership" isHorizontal="true">
        <dc:Bounds x="190" y="635" width="1760" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="272" y="137" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="demand_di" bpmnElement="demand">
        <dc:Bounds x="400" y="115" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="raise_survey_di" bpmnElement="raise_survey">
        <dc:Bounds x="570" y="520" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="wait_survey_di" bpmnElement="wait_survey">
        <dc:Bounds x="782" y="542" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="concept_di" bpmnElement="concept">
        <dc:Bounds x="910" y="265" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="cost_di" bpmnElement="cost">
        <dc:Bounds x="1080" y="265" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="board_di" bpmnElement="board">
        <dc:Bounds x="1250" y="670" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_board_di" bpmnElement="g_board">
        <dc:Bounds x="1455" y="685" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="revise_di" bpmnElement="revise">
        <dc:Bounds x="1590" y="370" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="publish_di" bpmnElement="publish">
        <dc:Bounds x="1590" y="265" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="1802" y="692" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_start_demand_di" bpmnElement="Flow_start_demand">
        <di:waypoint x="308" y="155" />
        <di:waypoint x="400" y="155" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_demand_raise_survey_di" bpmnElement="Flow_demand_raise_survey">
        <di:waypoint x="520" y="155" />
        <di:waypoint x="545" y="155" />
        <di:waypoint x="545" y="560" />
        <di:waypoint x="570" y="560" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_raise_survey_wait_survey_di" bpmnElement="Flow_raise_survey_wait_survey">
        <di:waypoint x="690" y="560" />
        <di:waypoint x="782" y="560" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_wait_survey_concept_di" bpmnElement="Flow_wait_survey_concept">
        <di:waypoint x="818" y="560" />
        <di:waypoint x="885" y="560" />
        <di:waypoint x="885" y="305" />
        <di:waypoint x="910" y="305" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_concept_cost_di" bpmnElement="Flow_concept_cost">
        <di:waypoint x="1030" y="305" />
        <di:waypoint x="1080" y="305" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_cost_board_di" bpmnElement="Flow_cost_board">
        <di:waypoint x="1200" y="305" />
        <di:waypoint x="1225" y="305" />
        <di:waypoint x="1225" y="710" />
        <di:waypoint x="1250" y="710" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_board_g_board_di" bpmnElement="Flow_board_g_board">
        <di:waypoint x="1370" y="710" />
        <di:waypoint x="1455" y="710" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_g_board_publish_di" bpmnElement="Flow_g_board_publish">
        <di:waypoint x="1505" y="710" />
        <di:waypoint x="1565" y="710" />
        <di:waypoint x="1565" y="305" />
        <di:waypoint x="1590" y="305" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_g_board_revise_di" bpmnElement="Flow_g_board_revise">
        <di:waypoint x="1505" y="710" />
        <di:waypoint x="1565" y="710" />
        <di:waypoint x="1565" y="410" />
        <di:waypoint x="1590" y="410" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_revise_board_di" bpmnElement="Flow_revise_board">
        <di:waypoint x="1650" y="450" />
        <di:waypoint x="1650" y="767" />
        <di:waypoint x="1310" y="767" />
        <di:waypoint x="1310" y="750" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_publish_end_di" bpmnElement="Flow_publish_end">
        <di:waypoint x="1710" y="305" />
        <di:waypoint x="1735" y="305" />
        <di:waypoint x="1735" y="710" />
        <di:waypoint x="1802" y="710" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
