        <di:waypoint x="2050" y="560" />
        <di:waypoint x="2142" y="560" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_wait_source_end_di" bpmnElement="Flow_wait_source_end">
        <di:waypoint x="2178" y="560" />
        <di:waypoint x="2245" y="560" />
        <di:waypoint x="2245" y="155" />
        <di:waypoint x="2312" y="155" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
