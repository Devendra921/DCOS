      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="prechecks_di" bpmnElement="prechecks">
        <dc:Bounds x="910" y="775" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_ready_di" bpmnElement="g_ready">
        <dc:Bounds x="1115" y="790" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fix_prechecks_di" bpmnElement="fix_prechecks">
        <dc:Bounds x="1250" y="880" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="raise_move_di" bpmnElement="raise_move">
        <dc:Bounds x="1250" y="520" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="wait_move_di" bpmnElement="wait_move">
        <dc:Bounds x="1462" y="542" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="confirm_di" bpmnElement="confirm">
        <dc:Bounds x="1590" y="775" width="120" height="80" />
      </bpmndi:BPMNShape>
