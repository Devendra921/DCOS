        <di:waypoint x="1905" y="665" />
        <di:waypoint x="1930" y="665" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_rollback_plan_di" bpmnElement="Flow_rollback_plan">
