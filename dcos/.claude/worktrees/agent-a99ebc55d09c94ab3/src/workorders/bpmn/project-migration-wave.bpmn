        <di:waypoint x="520" y="305" />
        <di:waypoint x="545" y="305" />
        <di:waypoint x="545" y="155" />
        <di:waypoint x="570" y="155" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_plan_g_plan_di" bpmnElement="Flow_plan_g_plan">
        <di:waypoint x="690" y="155" />
        <di:waypoint x="775" y="155" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_g_plan_prechecks_di" bpmnElement="Flow_g_plan_prechecks">
        <di:waypoint x="825" y="155" />
        <di:waypoint x="885" y="155" />
        <di:waypoint x="885" y="815" />
        <di:waypoint x="910" y="815" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_g_plan_replan_di" bpmnElement="Flow_g_plan_replan">
        <di:waypoint x="825" y="155" />
        <di:waypoint x="885" y="155" />
        <di:waypoint x="885" y="410" />
        <di:waypoint x="910" y="410" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_replan_plan_di" bpmnElement="Flow_replan_plan">
        <di:waypoint x="970" y="370" />
        <di:waypoint x="970" y="95" />
        <di:waypoint x="630" y="95" />
        <di:waypoint x="630" y="115" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_prechecks_g_ready_di" bpmnElement="Flow_prechecks_g_ready">
        <di:waypoint x="1030" y="815" />
        <di:waypoint x="1115" y="815" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_g_ready_raise_move_di" bpmnElement="Flow_g_ready_raise_move">
        <di:waypoint x="1165" y="815" />
        <di:waypoint x="1225" y="815" />
        <di:waypoint x="1225" y="560" />
        <di:waypoint x="1250" y="560" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_g_ready_fix_prechecks_di" bpmnElement="Flow_g_ready_fix_prechecks">
        <di:waypoint x="1165" y="815" />
        <di:waypoint x="1225" y="815" />
        <di:waypoint x="1225" y="920" />
        <di:waypoint x="1250" y="920" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_fix_prechecks_prechecks_di" bpmnElement="Flow_fix_prechecks_prechecks">
        <di:waypoint x="1310" y="960" />
        <di:waypoint x="1310" y="872" />
        <di:waypoint x="970" y="872" />
        <di:waypoint x="970" y="855" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_raise_move_wait_move_di" bpmnElement="Flow_raise_move_wait_move">
        <di:waypoint x="1370" y="560" />
        <di:waypoint x="1462" y="560" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_wait_move_confirm_di" bpmnElement="Flow_wait_move_confirm">
        <di:waypoint x="1498" y="560" />
        <di:waypoint x="1565" y="560" />
        <di:waypoint x="1565" y="815" />
        <di:waypoint x="1590" y="815" />
      </bpmndi:BPMNEdge>
