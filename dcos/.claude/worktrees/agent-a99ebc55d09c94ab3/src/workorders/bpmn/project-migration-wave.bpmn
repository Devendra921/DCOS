        <dc:Bounds x="1930" y="520" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="wait_source_di" bpmnElement="wait_source">
        <dc:Bounds x="2142" y="542" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="2312" y="137" width="36" height="36" />
      </bpmndi:BPMNShape>
