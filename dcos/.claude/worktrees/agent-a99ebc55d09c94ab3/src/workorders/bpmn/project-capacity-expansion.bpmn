        <dc:Bounds x="400" y="265" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_headroom_di" bpmnElement="g_headroom">
        <dc:Bounds x="605" y="280" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rework_study_di" bpmnElement="rework_study">
        <dc:Bounds x="740" y="370" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="release_pos_di" bpmnElement="release_pos">
        <dc:Bounds x="740" y="520" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="receive_di" bpmnElement="receive">
        <dc:Bounds x="910" y="520" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="b_delayed_expedite_di" bpmnElement="b_delayed_expedite">
        <dc:Bounds x="982" y="582" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="expedite_di" bpmnElement="expedite">
        <dc:Bounds x="1080" y="625" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="raise_install_di" bpmnElement="raise_install">
        <dc:Bounds x="1080" y="775" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="wait_install_di" bpmnElement="wait_install">
        <dc:Bounds x="1292" y="797" width="36" height="36" />
      </bpmndi:BPMNShape>
