        <dc:Bounds x="1420" y="775" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="wait_burnin_di" bpmnElement="wait_burnin">
        <dc:Bounds x="1632" y="797" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="go_nogo_di" bpmnElement="go_nogo">
        <dc:Bounds x="1760" y="1030" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_go_di" bpmnElement="g_go">
        <dc:Bounds x="1965" y="1045" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fix_di" bpmnElement="fix">
        <dc:Bounds x="2100" y="880" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="raise_cutover_di" bpmnElement="raise_cutover">
        <dc:Bounds x="2100" y="1030" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="wait_cutover_di" bpmnElement="wait_cutover">
        <dc:Bounds x="2312" y="1052" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="accept_di" bpmnElement="accept">
        <dc:Bounds x="2440" y="1030" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="2652" y="1052" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_start_study_di" bpmnElement="Flow_start_study">
        <di:waypoint x="308" y="155" />
        <di:waypoint x="375" y="155" />
        <di:waypoint x="375" y="305" />
        <di:waypoint x="400" y="305" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_study_g_headroom_di" bpmnElement="Flow_study_g_headroom">
        <di:waypoint x="520" y="305" />
        <di:waypoint x="605" y="305" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_g_headroom_release_pos_di" bpmnElement="Flow_g_headroom_release_pos">
        <di:waypoint x="655" y="305" />
        <di:waypoint x="715" y="305" />
        <di:waypoint x="715" y="560" />
        <di:waypoint x="740" y="560" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_g_headroom_rework_study_di" bpmnElement="Flow_g_headroom_rework_study">
        <di:waypoint x="655" y="305" />
        <di:waypoint x="715" y="305" />
        <di:waypoint x="715" y="410" />
        <di:waypoint x="740" y="410" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_rework_study_study_di" bpmnElement="Flow_rework_study_study">
        <di:waypoint x="800" y="450" />
        <di:waypoint x="800" y="362" />
        <di:waypoint x="460" y="362" />
        <di:waypoint x="460" y="345" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_release_pos_receive_di" bpmnElement="Flow_release_pos_receive">
        <di:waypoint x="860" y="560" />
        <di:waypoint x="910" y="560" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_receive_raise_install_di" bpmnElement="Flow_receive_raise_install">
        <di:waypoint x="1030" y="560" />
        <di:waypoint x="1055" y="560" />
        <di:waypoint x="1055" y="815" />
        <di:waypoint x="1080" y="815" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_raise_install_wait_install_di" bpmnElement="Flow_raise_install_wait_install">
        <di:waypoint x="1200" y="815" />
        <di:waypoint x="1292" y="815" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_wait_install_raise_burnin_di" bpmnElement="Flow_wait_install_raise_burnin">
        <di:waypoint x="1328" y="815" />
        <di:waypoint x="1420" y="815" />
      </bpmndi:BPMNEdge>
