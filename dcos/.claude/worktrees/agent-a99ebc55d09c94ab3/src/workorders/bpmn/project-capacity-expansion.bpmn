<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_project_capacity_expansion" targetNamespace="http://dcos.example.com/workorders" exporter="DCOS process generator" exporterVersion="1.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.6.0">
  <bpmn:collaboration id="Collaboration_project_capacity_expansion">
    <bpmn:participant id="Participant_project_capacity_expansion" name="PRJ-04 · Capacity expansion" processRef="project-capacity-expansion" />
  </bpmn:collaboration>
  <bpmn:process id="project-capacity-expansion" name="Capacity expansion" isExecutable="true">
    <bpmn:documentation>Adds compute, GPU, storage or power capacity to a live site: the power and cooling study must confirm headroom, purchase orders are released and kit received, installation and burn-in run as work orders under change, operations approves the cut-over (fixes go back to installation), the cut-over runs in a change window and operations accepts the capacity.</bpmn:documentation>
    <bpmn:extensionElements>
      <zeebe:versionTag value="v1" />
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_project_capacity_expansion">
      <bpmn:lane id="Lane_Project_manager" name="Project manager">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Design" name="Design">
        <bpmn:flowNodeRef>study</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_headroom</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rework_study</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Procurement" name="Procurement">
        <bpmn:flowNodeRef>release_pos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_delayed_expedite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>expedite</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Installation" name="Installation">
        <bpmn:flowNodeRef>raise_install</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait_install</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>raise_burnin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait_burnin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Operations" name="Operations">
        <bpmn:flowNodeRef>go_nogo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_go</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>raise_cutover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait_cutover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Expansion approved">
      <bpmn:outgoing>Flow_start_study</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="study" name="Confirm power and cooling study">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formKey="approve" />
        <zeebe:assignmentDefinition candidateGroups="Capacity Planner" />
        <zeebe:taskSchedule dueDate="=now() + duration(&#34;P2D&#34;)" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start_study</bpmn:incoming>
      <bpmn:incoming>Flow_rework_study_study</bpmn:incoming>
      <bpmn:outgoing>Flow_study_g_headroom</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_headroom" name="Headroom confirmed?" default="Flow_g_headroom_release_pos">
      <bpmn:incoming>Flow_study_g_headroom</bpmn:incoming>
      <bpmn:outgoing>Flow_g_headroom_release_pos</bpmn:outgoing>
      <bpmn:outgoing>Flow_g_headroom_rework_study</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="rework_study" name="Rework the study">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formKey="complete-with-evidence" />
        <zeebe:assignmentDefinition candidateGroups="Capacity Planner" />
        <zeebe:taskSchedule dueDate="=now() + duration(&#34;P1D&#34;)" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_g_headroom_rework_study</bpmn:incoming>
      <bpmn:outgoing>Flow_rework_study_study</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="release_pos" name="Release purchase orders">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formKey="approve" />
        <zeebe:assignmentDefinition candidateGroups="Finance Manager" />
        <zeebe:taskSchedule dueDate="=now() + duration(&#34;P1D&#34;)" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_g_headroom_release_pos</bpmn:incoming>
      <bpmn:outgoing>Flow_release_pos_receive</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="receive" name="Receive kit">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formKey="complete-with-evidence" />
        <zeebe:assignmentDefinition candidateGroups="Finance Manager" />
        <zeebe:taskSchedule dueDate="=now() + duration(&#34;P10D&#34;)" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_release_pos_receive</bpmn:incoming>
      <bpmn:incoming>Flow_expedite_receive</bpmn:incoming>
      <bpmn:outgoing>Flow_receive_raise_install</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="b_delayed_expedite" name="Delivery delayed" attachedToRef="receive" cancelActivity="false">
      <bpmn:outgoing>Flow_b_delayed_expedite_expedite</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_b_delayed_expedite" messageRef="Message_b_delayed_expedite" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="expedite" name="Expedite with the vendor">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formKey="acknowledge" />
        <zeebe:assignmentDefinition candidateGroups="Finance Manager" />
        <zeebe:taskSchedule dueDate="=now() + duration(&#34;PT8H&#34;)" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_b_delayed_expedite_expedite</bpmn:incoming>
      <bpmn:outgoing>Flow_expedite_receive</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="raise_install" name="Raise installation work orders">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="dcos.raise-work-orders" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_receive_raise_install</bpmn:incoming>
      <bpmn:outgoing>Flow_raise_install_wait_install</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="wait_install" name="Installation work closed">
      <bpmn:incoming>Flow_raise_install_wait_install</bpmn:incoming>
      <bpmn:outgoing>Flow_wait_install_raise_burnin</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_wait_install" messageRef="Message_wait_install" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="raise_burnin" name="Raise burn-in work orders">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="dcos.raise-work-orders" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_wait_install_raise_burnin</bpmn:incoming>
      <bpmn:outgoing>Flow_raise_burnin_wait_burnin</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="wait_burnin" name="Burn-in work closed">
      <bpmn:incoming>Flow_raise_burnin_wait_burnin</bpmn:incoming>
      <bpmn:outgoing>Flow_wait_burnin_go_nogo</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_wait_burnin" messageRef="Message_wait_burnin" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="go_nogo" name="Approve cut-over">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formKey="approve" />
        <zeebe:assignmentDefinition candidateGroups="Facilities Director" />
        <zeebe:taskSchedule dueDate="=now() + duration(&#34;PT8H&#34;)" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_wait_burnin_go_nogo</bpmn:incoming>
      <bpmn:incoming>Flow_fix_go_nogo</bpmn:incoming>
      <bpmn:outgoing>Flow_go_nogo_g_go</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_go" name="Go for cut-over?" default="Flow_g_go_raise_cutover">
      <bpmn:incoming>Flow_go_nogo_g_go</bpmn:incoming>
      <bpmn:outgoing>Flow_g_go_raise_cutover</bpmn:outgoing>
      <bpmn:outgoing>Flow_g_go_fix</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="fix" name="Fix open issues">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formKey="complete-with-evidence" />
        <zeebe:assignmentDefinition candidateGroups="Field Technician" />
        <zeebe:taskSchedule dueDate="=now() + duration(&#34;PT16H&#34;)" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_g_go_fix</bpmn:incoming>
      <bpmn:outgoing>Flow_fix_go_nogo</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="raise_cutover" name="Raise cut-over work orders">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="dcos.raise-work-orders" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_g_go_raise_cutover</bpmn:incoming>
      <bpmn:outgoing>Flow_raise_cutover_wait_cutover</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="wait_cutover" name="Cut-over work closed">
      <bpmn:incoming>Flow_raise_cutover_wait_cutover</bpmn:incoming>
      <bpmn:outgoing>Flow_wait_cutover_accept</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_wait_cutover" messageRef="Message_wait_cutover" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="accept" name="Accept capacity into operations">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formKey="sign-off" />
        <zeebe:assignmentDefinition candidateGroups="Facilities Director" />
        <zeebe:taskSchedule dueDate="=now() + duration(&#34;PT8H&#34;)" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_wait_cutover_accept</bpmn:incoming>
      <bpmn:outgoing>Flow_accept_end</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="end" name="Capacity in service">
      <bpmn:incoming>Flow_accept_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_start_study" sourceRef="start" targetRef="study" />
    <bpmn:sequenceFlow id="Flow_study_g_headroom" sourceRef="study" targetRef="g_headroom" />
    <bpmn:sequenceFlow id="Flow_g_headroom_release_pos" name="confirmed" sourceRef="g_headroom" targetRef="release_pos">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_g_headroom_rework_study" name="short" sourceRef="g_headroom" targetRef="rework_study">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_rework_study_study" sourceRef="rework_study" targetRef="study" />
    <bpmn:sequenceFlow id="Flow_release_pos_receive" sourceRef="release_pos" targetRef="receive" />
    <bpmn:sequenceFlow id="Flow_receive_raise_install" sourceRef="receive" targetRef="raise_install" />
    <bpmn:sequenceFlow id="Flow_raise_install_wait_install" sourceRef="raise_install" targetRef="wait_install" />
    <bpmn:sequenceFlow id="Flow_wait_install_raise_burnin" sourceRef="wait_install" targetRef="raise_burnin" />
    <bpmn:sequenceFlow id="Flow_raise_burnin_wait_burnin" sourceRef="raise_burnin" targetRef="wait_burnin" />
    <bpmn:sequenceFlow id="Flow_wait_burnin_go_nogo" sourceRef="wait_burnin" targetRef="go_nogo" />
    <bpmn:sequenceFlow id="Flow_go_nogo_g_go" sourceRef="go_nogo" targetRef="g_go" />
    <bpmn:sequenceFlow id="Flow_expedite_receive" sourceRef="expedite" targetRef="receive" />
    <bpmn:sequenceFlow id="Flow_g_go_raise_cutover" name="go" sourceRef="g_go" targetRef="raise_cutover">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_g_go_fix" name="no go" sourceRef="g_go" targetRef="fix">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_fix_go_nogo" sourceRef="fix" targetRef="go_nogo" />
    <bpmn:sequenceFlow id="Flow_raise_cutover_wait_cutover" sourceRef="raise_cutover" targetRef="wait_cutover" />
    <bpmn:sequenceFlow id="Flow_wait_cutover_accept" sourceRef="wait_cutover" targetRef="accept" />
    <bpmn:sequenceFlow id="Flow_accept_end" sourceRef="accept" targetRef="end" />
    <bpmn:sequenceFlow id="Flow_b_delayed_expedite_expedite" sourceRef="b_delayed_expedite" targetRef="expedite" />
  </bpmn:process>
  <bpmn:message id="Message_b_delayed_expedite" name="delivery-delayed">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=businessKey" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_wait_install" name="work-orders-closed">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=businessKey + &#34;:wait_install&#34;" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_wait_burnin" name="work-orders-closed">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=businessKey + &#34;:wait_burnin&#34;" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_wait_cutover" name="work-orders-closed">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=businessKey + &#34;:wait_cutover&#34;" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmndi:BPMNDiagram id="BPMNDiagram_project_capacity_expansion">
    <bpmndi:BPMNPlane id="BPMNPlane_project_capacity_expansion" bpmnElement="Collaboration_project_capacity_expansion">
      <bpmndi:BPMNShape id="Participant_project_capacity_expansion_di" bpmnElement="Participant_project_capacity_expansion" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="2640" height="1065" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Project_manager_di" bpmnElement="Lane_Project_manager" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="2610" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Design_di" bpmnElement="Lane_Design" isHorizontal="true">
        <dc:Bounds x="190" y="230" width="2610" height="255" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Procurement_di" bpmnElement="Lane_Procurement" isHorizontal="true">
        <dc:Bounds x="190" y="485" width="2610" height="255" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Installation_di" bpmnElement="Lane_Installation" isHorizontal="true">
        <dc:Bounds x="190" y="740" width="2610" height="255" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Operations_di" bpmnElement="Lane_Operations" isHorizontal="true">
        <dc:Bounds x="190" y="995" width="2610" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
