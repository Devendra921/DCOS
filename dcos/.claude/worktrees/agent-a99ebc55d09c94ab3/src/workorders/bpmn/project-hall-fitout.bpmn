        <dc:Bounds x="1760" y="775" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="wait_network_di" bpmnElement="wait_network">
        <dc:Bounds x="1972" y="797" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="commission_di" bpmnElement="commission">
        <dc:Bounds x="2100" y="1030" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_atp_di" bpmnElement="g_atp">
        <dc:Bounds x="2305" y="1045" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fix_tests_di" bpmnElement="fix_tests">
        <dc:Bounds x="2440" y="880" width="120" height="80" />
      </bpmndi:BPMNShape>
