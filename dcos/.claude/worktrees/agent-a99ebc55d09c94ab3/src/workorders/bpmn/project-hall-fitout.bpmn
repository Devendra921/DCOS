        <dc:Bounds x="1420" y="775" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="wait_racks_di" bpmnElement="wait_racks">
        <dc:Bounds x="1632" y="797" width="36" height="36" />
      </bpmndi:BPMNShape>
