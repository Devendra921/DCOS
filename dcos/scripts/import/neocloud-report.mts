/* Writes the NeoCloud import report: docs/imports/neocloud-2026-10-12.md
   (what each sheet became, records per collection, the automatic fixes and the warnings, start-up cost).
   Run: npx tsx scripts/import/neocloud-report.mts */
import { mkdirSync, writeFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import { buildSnapshotWithNeoCloud } from '../../src/mock/datasets/neocloudNode.ts';
import { INR_PER_USD, type ImportReport, type ReportLine } from '../../src/mock/datasets/dcoImport.ts';
import { NEOCLOUD_AS_OF } from '../../src/mock/datasets/neocloud.ts';
import { MockDB } from '../../src/mock/db/store.ts';

const { snapshot, reports, ms } = buildSnapshotWithNeoCloud('small');
const th = performance.now(); new MockDB().hydrate(snapshot); const hydrateMs = Math.round(performance.now() - th);
const [us, ind] = reports as [ImportReport, ImportReport];
const n = (x: number) => x.toLocaleString('en-US');
const esc = (s: string) => s.replace(/\|/g, '\\|');
const records = Object.values(snapshot).reduce((a, x) => a + x.length, 0);
const nc = (k: string) => (snapshot[k] ?? []).filter((r) => (r as { extRef?: { source?: string } }).extRef?.source?.startsWith('NeoCloud')).length;

const lines: string[] = [];
const p = (s = '') => lines.push(s);

p(`# NeoCloud import · ${NEOCLOUD_AS_OF}`);
p();
p(`Two customer workbooks in the DCO inventory template, loaded on top of the demo estate: **${us.workbook}** (24 sites, USD) and **${ind.workbook}** (24 sites, INR). With the 15 demo sites the app shows **63 sites**.`);
p();
p('Generated by `npx tsx scripts/import/neocloud-report.mts`. The mapping is `src/mock/datasets/dcoImport.ts` (`mergeDcoDataset`, pure and idempotent); the checks are `scripts/neocloud-import-smoke.mts`.');
p();
p('## How it loads and how to switch it off');
p();
p('- Start-up builds the demo estate, then loads the two extracted workbooks (`src/mock/datasets/neocloud/us.json`, `in.json`) and the importer as separate lazy chunks (fetched while the demo builds), merges them and hydrates the store. If the import fails the app starts with the demo estate and logs the error.');
p("- **Show only the demo estate:** open the app with `?estate=demo`, or set `localStorage['dcos.estate'] = 'demo'` (`'all'` or removing the key brings NeoCloud back). `setEstate('demo' | 'all')` from `src/mock/db` stores the choice and reloads. The URL parameter wins over the stored value.");
p('- **Scripts** load the demo estate unless `DCOS_ESTATE=all` is set (so the existing smokes are unchanged). `src/mock/datasets/neocloudNode.ts` has `buildSnapshotWithNeoCloud()` and `loadNeoCloudDatasetsSync()` for scripts.');
p('- Every imported record carries `extRef { source, id, importedAt }` with the workbook name (`NeoCloud US 2026-10-12` / `NeoCloud India 2026-10-12`) and its id in the workbook.');
p();
p('## Start-up cost (Node 20, this machine)');
p();
p('| step | time |');
p('|---|---|');
p(`| demo estate (unchanged) | ${n(ms.demo)} ms |`);
p(`| read both workbooks (JSON) | ${n(ms.read)} ms |`);
p(`| merge US + India | ${n(ms.merge)} ms (US ${us.ms} ms, India ${ind.ms} ms) |`);
p(`| hydrate the store | ${n(hydrateMs)} ms |`);
p(`| **total** | **${n(ms.demo + ms.read + ms.merge + hydrateMs)} ms** |`);
p();
p(`Records: ${n(Object.values(snapshot).reduce((a, x) => a + x.length, 0) - Object.values(snapshot).reduce((a, x) => a + x.filter((r) => (r as { extRef?: unknown }).extRef).length, 0))} demo + ${n(Object.values(snapshot).reduce((a, x) => a + x.filter((r) => (r as { extRef?: unknown }).extRef).length, 0))} imported = ${n(records)}. Heap: about 60 MB for the demo estate and about 105 MB more for NeoCloud. The browser downloads two 8.2 MB data chunks (about 0.7 MB each gzipped) in parallel with the demo build. The operations cockpit model (built after start-up and on edits) takes about 0.9 s with 63 sites (0.3 s demo only).`);
p();

for (const r of reports) {
  p(`## ${r.source}`);
  p();
  p(`Workbook \`${r.workbook}\` · services in ${r.currency}.`);
  p();
  p('| sheet | rows | became |');
  p('|---|---:|---|');
  for (const s of r.sheets) p(`| ${s.sheet} | ${n(s.rows)} | ${esc(s.became)} |`);
  p();
}

p('## Records per collection');
p();
p('Records written by each workbook (shared catalogue entries such as manufacturers, device types and the 11 customers in both estates are written once and reused).');
p();
p('| collection | US | India | NeoCloud in store | store total |');
p('|---|---:|---:|---:|---:|');
const colls = [...new Set([...Object.keys(us.collections), ...Object.keys(ind.collections)])].sort();
for (const k of colls) p(`| ${k} | ${n(us.collections[k] ?? 0)} | ${n(ind.collections[k] ?? 0)} | ${n(nc(k))} | ${n((snapshot[k] ?? []).length)} |`);
p();

const merged = (pick: (r: ImportReport) => ReportLine[]) => {
  const codes = [...new Set([...pick(us).map((x) => x.code), ...pick(ind).map((x) => x.code)])];
  return codes.map((code) => {
    const a = pick(us).find((x) => x.code === code), b = pick(ind).find((x) => x.code === code);
    return { code, title: (a ?? b)!.title.replace(/"US-"|"IN-"/g, '"US-" / "IN-"'), us: a?.count ?? 0, in: b?.count ?? 0, ex: [...new Set([...(a?.examples ?? []).slice(0, 3), ...(b?.examples ?? []).slice(0, 2)])] };
  });
};
p('## Automatic fixes');
p();
p(`Applied while mapping; counts are records affected. Customer revenue is one number per customer in USD: US services count at face value, India services at ${INR_PER_USD} INR per USD (\`INR_PER_USD\` in dcoImport.ts). Services themselves keep their own currency (the US workbook's "₹" label is wrong: its amounts are USD).`);
p();
p('| fix | what was done | US | India | examples |');
p('|---|---|---:|---:|---|');
for (const f of merged((r) => r.fixes)) p(`| ${f.code} | ${esc(f.title)} | ${n(f.us)} | ${n(f.in)} | ${esc(f.ex.join('; '))} |`);
p();
p('## Warnings (imported as they are)');
p();
p('| warning | what | US | India | ids |');
p('|---|---|---:|---:|---|');
for (const w of merged((r) => r.warnings)) p(`| ${w.code} | ${esc(w.title)} | ${n(w.us)} | ${n(w.in)} | ${esc(w.ex.join('; '))} |`);
p();
p('## Mapping notes');
p();
p('- **Hierarchy.** Region per country and workbook region ("US · Northeast", "India · West") under a NeoCloud enterprise; a campus per city; one building per site; floors and rooms as in the workbook. Every room is a hall with its room type and its own cooling zone (setpoint = average design supply of its units). Site status: on-air → Operational, in-progress → Construction, planned → Planned. All sites use the `ai-gpu-factory` type.');
p('- **Racks.** Workbook ids kept. Rows are Row records (Row A, B, …) and racks sit on the hall grid. Purpose from the role (Core, Access and ODF / patching → Network; the original role is the rack role). A/B feeds point at the utility feeds, liquid racks at their CDU.');
p('- **Plant.** Power_Feeds → utility feeds (AC, and −48 V DC rectifier feeds); UPS, generators, DC plant (rectifiers and battery banks). Cooling_Units → CRAH/CRAC/CDU cooling units in the room\'s zone; the CDUs sheet → CDU records with flow (the cockpit matches a CDU unit and its CDU record by room and name, so nothing is counted twice).');
p('- **Devices.** Workbook ids kept; manufacturer and device-type catalogue entries per make and model (U height from u_size); role, layer, OS, MAC, serial, management IP, monitored flag and collector as given. Ready → Active, Planned → Ordered (status Planned). Monitored network gear gets an NMS managed-device record and NMS interfaces. GPU servers carry the GPU spec from GPU_Nodes and their cluster.');
p('- **Ports and links.** Interfaces → interface components (id `<device>:<port>`; optic kept as a custom field). LLDP links → cables between those components (cable type from speed, optic and whether both ends share a rack; strand colour, patch ports and cable label kept); links between network devices also become topology links. BGP / OSPF / ISIS / LSP links → routing sessions.');
p('- **Customers and services.** The 11 customers with the same id and name in both workbooks are one customer; CUST-2073 names a different company in India and becomes IN-CUST-2073. Services keep their currency, run on their device and GPU nodes; their racks come from those devices.');
p('- **History.** Snapshot alerts, incidents and changes are imported as records (ids prefixed US- / IN-), with statuses mapped (alerts active / acknowledged; incident status as given; change Pending approval → Submitted, Completed → Closed, In progress → InProgress, Rolled back → RolledBack). Changes are history: no BPMN process is started. Maintenance changes also get a maintenance window; approvers become approval steps.');
p();
p('## Known gaps');
p();
p('- Rack draw, device draw, UPS load, room areas and return temperatures are estimates (see the fixes); the workbooks carry no live readings.');
p('- No rack-level power chain (panels, rack PDUs), IPAM (only management IPs on devices), circuits or carrier records: the workbooks do not carry them.');
p('- CPU, memory and storage capacity are not in the workbooks; the per-site compute roll-up holds GPU counts only.');
p('- Service start dates are blank in both workbooks.');
p('- Alerts on PoP and access-site nodes (not in the Devices sheet) keep the node name and the site, with no device link.');
p('- Snapshot timestamps carry no time zone and are read as UTC; the snapshot is from 1 October 2026, so "active" alerts are 12 days old.');
p('- A few screens list large collections with a page size; the device, rack, cabling and NMS pages were raised to hold the larger store, other screens may still cut long lists.');
p();

const out = fileURLToPath(new URL(`../../docs/imports/neocloud-${NEOCLOUD_AS_OF}.md`, import.meta.url));
mkdirSync(fileURLToPath(new URL('../../docs/imports/', import.meta.url)), { recursive: true });
writeFileSync(out, `${lines.join('\n')}\n`);
console.log(`wrote ${out} (${lines.length} lines)`);
